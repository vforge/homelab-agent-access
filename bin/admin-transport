#!/usr/bin/env bash
# Shared administrative SSH transport. Only the trusted administrator may use
# --sudo; the agent identity never has access to this path.

admin_run() {
  local remote="$1" mode="$2" directory rc=0 fetch_rc=0 cleanup_rc=0 arg
  shift 2

  if [[ "$mode" == direct ]]; then
    ssh -o BatchMode=yes -o RequestTTY=no -o StrictHostKeyChecking=yes \
      -o ConnectTimeout=10 -- "$remote" bash -s -- "$@"
    return
  fi
  [[ "$mode" == sudo ]] || { echo 'invalid admin transport' >&2; return 64; }

  # The second connection needs the local controlling terminal for sudo's
  # password prompt. Never read a password from the provisioning script's stdin.
  if ! (: </dev/tty >/dev/tty) 2>/dev/null; then
    echo '--sudo requires an interactive controlling terminal' >&2
    return 64
  fi
  # SSH joins remote arguments into a shell command. Reject anything that could
  # introduce a new shell token, even if a caller has already validated it.
  for arg in "$@"; do
    if [[ ! "$arg" =~ ^[A-Za-z0-9_+./=-]+$ ]]; then
      echo 'unsafe administrative argument' >&2
      return 64
    fi
  done

  # Stage the trusted script in an administrator-owned 0700 directory. The
  # administrator is already trusted to run sudo; no agent-controlled content
  # is executed. Capturing result streams separately keeps --json parseable.
  directory="$(ssh -o BatchMode=yes -o RequestTTY=no \
    -o StrictHostKeyChecking=yes -o ConnectTimeout=10 -- "$remote" \
    'set -eu; umask 077; dir=$(mktemp -d /tmp/homelab-agent-access.XXXXXXXX); cat > "$dir/run"; : > "$dir/stdout"; : > "$dir/stderr"; printf "%s\n" "$dir"')" || return
  if [[ ! "$directory" =~ ^/tmp/homelab-agent-access\.[A-Za-z0-9]{8}$ ]]; then
    echo 'invalid remote staging directory; inspect the host before retrying' >&2
    return 73
  fi

  # The path is generated by mktemp and strictly checked above; callers'
  # arguments are constrained to single shell tokens. sudo reads /dev/tty,
  # while the script reads its own file rather than the prompt's input.
  if ssh -tt -o BatchMode=yes -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 -- "$remote" \
    "sudo -- /bin/bash -- $directory/run $* > $directory/stdout 2> $directory/stderr" \
    < /dev/tty > /dev/tty; then
    rc=0
  else
    rc=$?
  fi
  ssh -n -o BatchMode=yes -o RequestTTY=no -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 -- "$remote" cat -- "$directory/stdout" || fetch_rc=$?
  ssh -n -o BatchMode=yes -o RequestTTY=no -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 -- "$remote" cat -- "$directory/stderr" >&2 || fetch_rc=$?
  ssh -n -o BatchMode=yes -o RequestTTY=no -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 -- "$remote" rm -f -- \
    "$directory/run" "$directory/stdout" "$directory/stderr" || cleanup_rc=$?
  ssh -n -o BatchMode=yes -o RequestTTY=no -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 -- "$remote" rmdir -- "$directory" || cleanup_rc=$?
  if (( fetch_rc != 0 || cleanup_rc != 0 )); then
    echo "failed to fetch results or clean temporary admin files: $directory" >&2
    return 74
  fi
  return "$rc"
}
